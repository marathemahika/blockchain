# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/ewaste_platform

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRE=30d

# Email Service (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@ewaste-platform.com
FROM_NAME=EWaste Platform

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Carbon Credit Configuration
CARBON_CREDIT_RATE=0.02
BASE_POINTS_PER_KG=10

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# ============================================
# BLOCKCHAIN CONFIGURATION (New)
# ============================================

# Blockchain RPC URL (Ethereum node provider)
# For Sepolia Testnet: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# For Local Hardhat: http://127.0.0.1:8545
# For Mainnet: https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key

# Private Key of wallet that will call smart contract functions
# ⚠️  NEVER commit this to version control!
# Get from: MetaMask > Account Details > Export Private Key
# Format: without 0x prefix (just the hex string)
BLOCKCHAIN_PRIVATE_KEY=your_wallet_private_key_without_0x_prefix

# Smart Contract Address (deployed CarbonRewards contract)
# Get from: Deployment transaction on blockchain explorer
# Format: 0x followed by 40 hex characters
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
